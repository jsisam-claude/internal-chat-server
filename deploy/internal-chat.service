[Unit]
Description=internal chat server (folder-queue, stdlib-only)
After=network-online.target
Wants=network-online.target

[Service]
User=internal-chat
Group=internal-chat
# The user file defaults to <data>/passwd (service-writable: the server
# rewrites one line on a self-service password change). To FORBID
# self-service changes, keep it root-owned in /etc and point at it:
#     --roster /etc/internal-chat/passwd \
# What forbids the write is the root-owned DIRECTORY (plus ProtectSystem=
# strict below, which leaves /etc read-only for this service): the lock and
# the atomic replace both create files there. A read-only passwd FILE inside
# a writable directory is simply replaced, so it hardens nothing. With the
# directory locked down, POST /api/password answers 503 and logins keep
# working. Bootstrap it with: chatserver.py adduser <u> --roster <path>.
# An unreadable or absent file denies every login rather than failing open.
ExecStart=/usr/bin/python3 /opt/internal-chat/chatserver.py serve \
    --data /var/lib/internal-chat \
    --cert /etc/internal-chat/server.pem \
    --static /opt/internal-chat/static \
    --port 8443 --retain-days 0
Restart=on-failure
RestartSec=3

# Sandboxing per DESIGN.md: uploads must never be executable or reachable
# as anything but opaque bytes, and the service owns nothing but its data.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/internal-chat
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
